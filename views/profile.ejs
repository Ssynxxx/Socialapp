<h1>Profile</h1>

<% if (user.Profile) { %>
  <img src="<%= user.Profile.imageProfile %>" alt="Foto profile" width="120">
  <h2><%= user.Profile.name %></h2>
  <p>@<%= user.username || user.email %></p>
  <p><%= user.Profile.bio %></p>
  <a href="/profile/edit">Edit profile</a>
<% } else { %>
  <p>Profile belum dibuat.</p>
<% } %>